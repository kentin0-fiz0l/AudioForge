# AudioForge C++ Formatting Style
# Based on LLVM style with JUCE conventions

BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Line length
ColumnLimit: 100

# Braces
BreakBeforeBraces: Allman

# Pointers and references
PointerAlignment: Left

# Includes
SortIncludes: true

# Classes
AccessModifierOffset: -4
